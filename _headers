# Cloudflare Pages response headers. HTML, CSS and JS keep the default (revalidate every visit),
# because their names don't change between deploys.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# scripts/build-images.sh overwrites images under the same names, so a week, not forever.
/img/*
  Cache-Control: public, max-age=604800

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Keep the pages.dev copies (production and previews) out of search results; the studio domain is canonical.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
